# HTTPS and edge rate limits in front of the API (compose.proxy.yaml, docs/DEPLOYMENT.md).
# ${DOMAIN} is filled in from the environment when the container starts.

# Per client address. Sign-in and similar: 10 a minute (bursts of 5). Rest of the API: 10 a
# second (bursts of 40). The API also throttles sign-in itself (app/api/throttle.py).
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_status 429;
limit_req_log_level warn;

# The API, as however many replicas run (compose.proxy.yaml: API_REPLICAS). Docker's DNS at
# 127.0.0.11 returns every replica; `resolve` re-checks it every 10 seconds, so replicas that
# are added, removed or restarted (new addresses) are followed without reloading nginx.
resolver 127.0.0.11 valid=10s ipv6=off;
upstream mediaflow_api {
    zone mediaflow_api 64k;
    server api:8000 resolve;
    keepalive 32;
    keepalive_timeout 60s;  # below the API's 75 s (Dockerfile), so nginx always closes first
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};
    server_tokens off;

    # Let's Encrypt HTTP-01 challenges (certbot --webroot), then everything goes to HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Uploads: the API enforces the exact per-type limits (MAX_IMAGE_MB, MAX_VIDEO_UPLOAD_MB=1024);
    # this only has to be larger. Stream them through instead of buffering on the proxy's disk.
    client_max_body_size 1100m;
    proxy_request_buffering off;

    # POST /jobs may wait up to 5 minutes for the draft before answering 202.
    proxy_read_timeout 330s;
    proxy_send_timeout 330s;
    proxy_http_version 1.1;
    proxy_set_header Connection "";  # reuse connections to the API (upstream keepalive)
    # A replica that is restarting or gone: give up on it within 3 s and try another, instead
    # of the client waiting out a dead address. nginx never re-sends a POST that reached a
    # replica (non_idempotent is off), so an upload is never submitted twice.
    proxy_connect_timeout 3s;
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 3;
    proxy_next_upstream_timeout 10s;
    proxy_set_header Host $host;
    # Overwrite, never append: the API trusts this header (FORWARDED_ALLOW_IPS), so a client must
    # not be able to supply its own address and slip past the per-address limits.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;

    location ~ ^/api/v1/(auth/(login|signup)|invitations/(lookup|accept))$ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://mediaflow_api;
    }
    # Signed media links: a playing video makes many Range requests; the links are short-lived
    # and signed, so they are not rate limited here.
    location /api/v1/media/ {
        proxy_pass http://mediaflow_api;
    }
    # Media Instagram fetches for a post: signed, short-lived links, fetched by Meta's servers.
    location /api/v1/publish-media/ {
        proxy_pass http://mediaflow_api;
    }
    # Live updates (Server-Sent Events): one long-lived response per open browser. Pass each
    # message through at once, and allow it to stay open (the API ends it every 10 minutes and
    # sends a heartbeat every 20 seconds). One connection per tab, so no request rate limit.
    location = /api/v1/events {
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_pass http://mediaflow_api;
    }
    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://mediaflow_api;
    }
    location / {
        proxy_pass http://mediaflow_api;
    }
}
