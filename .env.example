# Copy once:  cp -n .env.example .env     (-n = never overwrite an existing .env)
# Never commit .env. Never paste it into chat.
# FORMAT RULES: no spaces around "=", no quotes, comments only on their own line.

REDIS_URL=redis://localhost:6379/0
QUEUE_PREFIX=ma

# --- FastAPI backend ---
# PostgreSQL database URL. URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://media_queue:replace-me@localhost:5432/media_queue
# Generate with: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
MEDIA_STORAGE_DIR=uploads

# --- required: real Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- limits: copy from YOUR AI Studio rate-limit page (per model, per project) ---
# Unset defaults are deliberately low: 5 per minute, 100 per day.
GEMINI_RPM=
GEMINI_RPD=
GEMINI_BURST=1

# --- optional tuning ---
# VIDEO_FPS=1.0
# IMAGE_MAX_SIDE=1024
# MAX_IMAGE_MB=10
# MAX_VIDEO_MB=100
# MAX_VIDEO_UPLOAD_MB=1024
# QUEUE_LEASE_S=900
# QUEUE_MAX_ATTEMPTS=5
