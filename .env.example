# Copy once:  cp -n .env.example .env     (-n = never overwrite an existing .env)
# Never commit .env. Never paste it into chat.
# FORMAT RULES: no spaces around "=", no quotes, comments only on their own line.

REDIS_URL=redis://localhost:6379/0
QUEUE_PREFIX=ma

# --- Docker Compose only (compose.yaml sets DATABASE_URL/REDIS_URL for its containers) ---
# Password for the Compose PostgreSQL container. REQUIRED: Compose refuses to start without it,
# and the app refuses a weak one (16+ random characters: openssl rand -hex 24). Set it before the
# first `make docker-up`; Postgres only reads it when its volume is created (docs/DEPLOYMENT.md).
POSTGRES_PASSWORD=
# Host ports for the real and demo stacks.
# MEDIAFLOW_PORT=8080
# MEDIAFLOW_DEMO_PORT=8081

# --- FastAPI backend ---
# PostgreSQL database URL. URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://media_queue:replace-me@localhost:5432/media_queue
# Generate with: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
MEDIA_STORAGE_DIR=uploads
# Where originals live: local (MEDIA_STORAGE_DIR, shared by API and workers) or s3.
MEDIA_STORAGE=local
# For MEDIA_STORAGE=s3 (AWS S3, Cloudflare R2, MinIO, ...). Credentials come from the
# standard AWS variables (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) or an instance role.
# S3_BUCKET=
# S3_PREFIX=originals/
# S3_ENDPOINT_URL=
# S3_REGION=
# Host browsers use for presigned links, if not S3_ENDPOINT_URL (e.g. MinIO behind a proxy).
# S3_PUBLIC_ENDPOINT_URL=
# Server-side encryption for new uploads: AES256 or aws:kms (with S3_SSE_KMS_KEY_ID).
# S3_SSE=AES256
# Originals idle this many days are deleted (drafts are kept). 0 keeps them forever.
MEDIA_RETENTION_DAYS=30
# Ceiling on what a workspace may choose (0 = none). See docs/STORAGE.md.
MEDIA_RETENTION_MAX_DAYS=0
# Lifetime of expiring media links, in seconds (30-3600).
MEDIA_LINK_TTL_S=300
# Let anyone create an account plus their own workspace from the sign-in screen.
ALLOW_SIGNUP=0
# Publishing providers (docs/PUBLISHING.md), comma separated: "mock" (the sandbox, nothing
# leaves the server) and/or "meta" (your real Facebook Page and Instagram). "none" disables.
PUBLISHING_PROVIDERS=mock
# Fernet key for publishing credentials at rest (python -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())"). Derived from JWT_SECRET when empty.
PUBLISHING_KEY=
# This app's public address, used in email links and so Instagram can fetch the photo or video
# (Instagram downloads media itself). Must be https:// and reachable from the internet.
# PUBLIC_BASE_URL=https://media.example.com

# ── Meta: Facebook Page + Instagram business account ──────────────────────────────────────
# Used when PUBLISHING_PROVIDERS includes "meta". Steps: docs/PUBLISHING.md, "Meta". The token
# is a secret: anyone holding it can post as your Page. Never commit it or paste it in chat.
# The Facebook Page's numeric id (Page > About > Page transparency, or Business Suite > Settings).
# META_PAGE_ID=104523456789012
# A Page access token from a system user (Business settings > Users > System users >
# Generate token), with pages_show_list, pages_read_engagement, pages_manage_posts,
# instagram_basic, instagram_content_publish, business_management. Choose "Never" expiry.
# META_PAGE_ACCESS_TOKEN=EAAG...replace-me...ZDZD
# The Instagram business account linked to that Page (leave empty for Facebook only):
# GET https://graph.facebook.com/v24.0/<META_PAGE_ID>?fields=instagram_business_account
# META_INSTAGRAM_ACCOUNT_ID=17841400000000000
# Your Meta app's secret (App settings > Basic). Optional; when set, every call carries an
# appsecret_proof, so a leaked token alone can't be used from elsewhere if you also turn on
# "Require app secret" in the app's advanced settings.
# META_APP_SECRET=0123456789abcdef0123456789abcdef
# Graph API version (default v24.0).
# META_GRAPH_VERSION=v24.0

# ── Email notifications (app/api/notifications.py) ────────────────────────────────────────
# Leave SMTP_HOST empty to keep notifications in the app only (the bell). With it set, the
# worker emails copies: drafts to review, decisions, published or failed posts, invitations.
# Any SMTP service works (Google Workspace, Microsoft 365, SendGrid, Mailgun, Amazon SES...).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# starttls (port 587, the usual) | ssl (port 465) | none (port 25, local relays only)
# SMTP_SECURITY=starttls
# SMTP_USERNAME=notifications@yourcompany.com
# For Gmail/Google Workspace this is an app password, not the account password.
# SMTP_PASSWORD=app-password-here
# The sender people see. Use an address your SMTP account may send as.
# SMTP_FROM=MediaFlow <notifications@yourcompany.com>

# ── Capacity (docs/OPERATIONS.md, "Capacity") ──────────────────────────────────────────────
# Per API process: requests at once, and database connections (keep size + overflow >= threads).
# API_THREADS=40
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10
# Password checks at once (Argon2, 64 MiB each); default = CPUs this container may use.
# PASSWORD_HASH_CONCURRENCY=4
# How long a sign-in waits its turn before "busy, try again" (seconds).
# PASSWORD_HASH_WAIT_S=30
# API containers behind the HTTPS proxy (compose.proxy.yaml), and PostgreSQL's connection cap.
# API_REPLICAS=2
# POSTGRES_MAX_CONNECTIONS=200

# Words a reviewer is warned about before approving (default prompts/flagged_phrases.txt).
# FLAGGED_PHRASES_FILE=
# How long an invitation link stays valid (hours, 1-720).
INVITATION_TTL_HOURS=168
# Run a queue worker inside the API process (development). Production: run `make worker`.
EMBEDDED_WORKER=0

# --- observability (docs/OPERATIONS.md) ---
# json: one JSON object per line (containers default); text: readable in a terminal.
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# Private Prometheus endpoint for this process; unset disables it. Never publish this port.
# METRICS_PORT=9100
# Export traces over OTLP/HTTP (Jaeger, Grafana Tempo, Honeycomb, ...). Unset: trace ids are
# still written to logs, but spans are not exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Fraction of new traces to keep (0.0-1.0).
# OTEL_TRACES_SAMPLER_ARG=1.0
# Grafana admin password for compose.observability.yaml (anonymous users get read-only).
# GRAFANA_ADMIN_PASSWORD=

# --- demo mode: try everything with no Gemini key and no PostgreSQL ---
# DEMO_MODE=1 uses an offline draft writer, SQLite, an embedded worker and seeded demo
# accounts. Easiest: `make demo`. Never enable on a real deployment.
# DEMO_MODE=0

# --- required (unless DEMO_MODE=1): real Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
# The Gemini system prompt (copy rules + fact sheet). Default: prompts/system_prompt.md.
# SYSTEM_PROMPT_FILE=

# --- limits: copy from YOUR AI Studio rate-limit page (per model, per project) ---
# Unset defaults are deliberately low: 5 per minute, 100 per day.
GEMINI_RPM=
GEMINI_RPD=
GEMINI_BURST=1

# --- optional tuning ---
# VIDEO_FPS=1.0
# IMAGE_MAX_SIDE=1024
# MAX_IMAGE_MB=10
# MAX_VIDEO_MB=100
# MAX_VIDEO_UPLOAD_MB=1024
# QUEUE_LEASE_S=900
# QUEUE_MAX_ATTEMPTS=5
